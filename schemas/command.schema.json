{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RBX Bridge Command",
  "description": "Envelope de un comando del protocolo Roblox Agent Bridge v0.1. El agente escribe estos archivos en commands/pending/ y el plugin de Studio los valida y ejecuta.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "title", "created_by", "created_at", "operations"],
  "properties": {
    "version": { "const": "0.1" },
    "id": { "type": "string", "pattern": "^cmd_[0-9]{6}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "created_by": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "request": { "type": "string" },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "atomic": { "type": "boolean", "default": false },
        "dry_run": { "type": "boolean", "default": false },
        "require_approval": { "type": "boolean", "default": true },
        "create_waypoint": { "type": "boolean", "default": true }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "$ref": "#/$defs/operation" }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "description": "Path con '.' como separador, empezando por un servicio raíz permitido.",
      "pattern": "^(Workspace|ReplicatedStorage|ServerStorage|ServerScriptService|StarterGui|StarterPack|StarterPlayer|Lighting|SoundService|Teams)(\\\\..+)?$"
    },
    "opId": { "type": "string", "pattern": "^op_[0-9]+$" },
    "vector3": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "id", "path", "max_depth"],
          "properties": {
            "op": { "const": "inspect_tree" },
            "id": { "$ref": "#/$defs/opId" },
            "path": { "$ref": "#/$defs/path" },
            "max_depth": { "type": "integer", "minimum": 1, "maximum": 10 },
            "class_filter": { "type": "array", "items": { "type": "string" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "id", "path"],
          "properties": {
            "op": { "const": "inspect_instance" },
            "id": { "$ref": "#/$defs/opId" },
            "path": { "$ref": "#/$defs/path" },
            "include_children": { "type": "boolean", "default": true },
            "include_attributes": { "type": "boolean", "default": true }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "id", "path"],
          "properties": {
            "op": { "const": "find_instances" },
            "id": { "$ref": "#/$defs/opId" },
            "path": { "$ref": "#/$defs/path" },
            "class": { "type": "string" },
            "name_pattern": { "type": "string" },
            "attribute": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name"],
              "properties": { "name": { "type": "string" }, "value": true }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "id", "path", "class"],
          "properties": {
            "op": { "const": "ensure_instance" },
            "id": { "$ref": "#/$defs/opId" },
            "path": { "$ref": "#/$defs/path" },
            "class": { "type": "string" },
            "properties": { "type": "object" },
            "create_parents": { "type": "boolean", "default": false }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "id", "path", "class"],
          "properties": {
            "op": { "const": "create_instance" },
            "id": { "$ref": "#/$defs/opId" },
            "path": { "$ref": "#/$defs/path" },
            "class": { "type": "string" },
            "properties": { "type": "object" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "id", "path", "property", "value"],
          "properties": {
            "op": { "const": "set_property" },
            "id": { "$ref": "#/$defs/opId" },
            "path": { "$ref": "#/$defs/path" },
            "property": { "type": "string", "minLength": 1 },
            "value": true
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "id", "path", "name", "value"],
          "properties": {
            "op": { "const": "set_attribute" },
            "id": { "$ref": "#/$defs/opId" },
            "path": { "$ref": "#/$defs/path" },
            "name": { "type": "string", "minLength": 1 },
            "value": true
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "id", "path"],
          "properties": {
            "op": { "const": "set_transform" },
            "id": { "$ref": "#/$defs/opId" },
            "path": { "$ref": "#/$defs/path" },
            "position": { "$ref": "#/$defs/vector3" },
            "rotation": { "$ref": "#/$defs/vector3" },
            "size": { "$ref": "#/$defs/vector3" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "id", "path", "material"],
          "properties": {
            "op": { "const": "apply_material" },
            "id": { "$ref": "#/$defs/opId" },
            "path": { "$ref": "#/$defs/path" },
            "material": { "type": "string" },
            "color": { "$ref": "#/$defs/vector3" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "id", "path", "new_parent"],
          "properties": {
            "op": { "const": "move_instance" },
            "id": { "$ref": "#/$defs/opId" },
            "path": { "$ref": "#/$defs/path" },
            "new_parent": { "$ref": "#/$defs/path" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "id", "path", "new_name"],
          "properties": {
            "op": { "const": "rename_instance" },
            "id": { "$ref": "#/$defs/opId" },
            "path": { "$ref": "#/$defs/path" },
            "new_name": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "id", "path", "new_parent"],
          "properties": {
            "op": { "const": "clone_instance" },
            "id": { "$ref": "#/$defs/opId" },
            "path": { "$ref": "#/$defs/path" },
            "new_parent": { "$ref": "#/$defs/path" },
            "new_name": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "id", "path"],
          "properties": {
            "op": { "const": "delete_instance" },
            "id": { "$ref": "#/$defs/opId" },
            "path": { "$ref": "#/$defs/path" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "id", "path", "source"],
          "properties": {
            "op": { "const": "set_script_source" },
            "id": { "$ref": "#/$defs/opId" },
            "path": { "$ref": "#/$defs/path" },
            "source": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "id", "paths", "model_name", "parent"],
          "properties": {
            "op": { "const": "group_instances" },
            "id": { "$ref": "#/$defs/opId" },
            "paths": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/path" } },
            "model_name": { "type": "string", "minLength": 1 },
            "parent": { "$ref": "#/$defs/path" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "id", "structure", "params"],
          "properties": {
            "op": { "const": "build_structure" },
            "id": { "$ref": "#/$defs/opId" },
            "structure": { "enum": ["wall", "platform", "staircase", "arena_floor", "tower", "bridge", "gate", "road", "room"] },
            "params": { "type": "object" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "id", "parts"],
          "properties": {
            "op": { "const": "build_from_spec" },
            "id": { "$ref": "#/$defs/opId" },
            "parts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["class"],
                "properties": {
                  "class": { "type": "string" },
                  "name": { "type": "string" },
                  "properties": { "type": "object" },
                  "position": { "$ref": "#/$defs/vector3" },
                  "rotation": { "$ref": "#/$defs/vector3" },
                  "size": { "$ref": "#/$defs/vector3" }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "id", "asset_id"],
          "properties": {
            "op": { "const": "insert_asset" },
            "id": { "$ref": "#/$defs/opId" },
            "asset_id": { "type": "integer", "minimum": 1, "description": "ID del asset de la Toolbox/Creator Store. Debe ser gratuito/público o propiedad de la cuenta." },
            "path": { "$ref": "#/$defs/path" },
            "position": { "$ref": "#/$defs/vector3" },
            "name": { "type": "string", "minLength": 1 },
            "allow_scripts": { "type": "boolean", "default": false, "description": "Por defecto se ELIMINAN todos los scripts del asset insertado (seguridad). true los conserva y fuerza aprobación humana." }
          }
        }
      ]
    }
  }
}
