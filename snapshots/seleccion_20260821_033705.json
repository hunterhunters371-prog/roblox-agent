ate.Bridge.Part","color":[125,63,0],"class":"Part","name":"Part","position":[5.242095470428467,8.130677223205567,377.04400634765627],"anchored":true,"material":"Plastic","shape":"Block","size":[0.2674652338027954,7.075507640838623,1.9406627416610718]},{"path":"Workspace.Map.Plots.PlotTemplate.Bridge.Part","color":[125,63,0],"class":"Part","name":"Part","position":[7.679021835327148,7.546446323394775,377.04400634765627],"anchored":true,"material":"Plastic","shape":"Block","size":[0.2674652338027954,7.075507640838623,1.9406628608703614]},{"path":"Workspace.Map.Plots.PlotTemplate.Bridge.Model","name":"Model","class":"Model","pivot":[8.854839324951172,7.39190673828125,377.0797119140625],"children":[{"name":"Part","class":"Part"},{"name":"Part","class":"Part"},{"name":"Part","class":"Part"},{"name":"Part","class":"Part"},{"name":"Part","class":"Part"},{"name":"Part","class":"Part"}]},{"anchored":true,"path":"Workspace.Map.Plots.PlotTemplate.Bridge.Union","name":"Union","position":[11.735957145690918,11.914756774902344,381.1890563964844],"color":[148,74,0],"class":"UnionOperation","material":"Plastic","size":[0.0892333984375,15.042335510253907,6.372864246368408]}]},{"children":[{"path":"Workspace.Map.Plots.PlotTemplate.OwnerBillboard.BillboardGui","name":"BillboardGui","class":"BillboardGui","children":[{"path":"Workspace.Map.Plots.PlotTemplate.OwnerBillboard.BillboardGui.NameLabel","name":"NameLabel","class":"TextLabel","children":[{"class":"UIStroke","name":"UIStroke","path":"Workspace.Map.Plots.PlotTemplate.OwnerBillboard.BillboardGui.NameLabel.UIStroke"}],"gui":{"visible":true,"text_size":14,"z_index":2,"background_color":[255,255,255],"text_color":[255,255,255],"layout_order":0,"font":"Cartoon","position":{"scaleY":1,"scaleX":0.5,"offsetX":0,"offsetY":0},"anchor_point":"0.5, 1","text":"PlayerName","background_transparency":1,"size":{"scaleY":0.4000000059604645,"scaleX":1.5,"offsetX":0,"offsetY":0}}},{"path":"Workspace.Map.Plots.PlotTemplate.OwnerBillboard.BillboardGui.ImageLabel","class":"ImageLabel","name":"ImageLabel","gui":{"visible":true,"z_index":1,"background_color":[255,255,255],"scale_type":"Stretch","layout_order":0,"image_color":[255,255,255],"position":{"scaleY":0,"scaleX":0,"offsetX":0,"offsetY":0},"anchor_point":"0, 0","image":"rbxthumb://type=AvatarHeadShot&id=4856963568&w=180&h=180","background_transparency":1,"size":{"scaleY":1,"scaleX":1,"offsetX":0,"offsetY":0}}}],"layer":{"enabled":false,"studs_offset":[0,0,0],"always_on_top":false,"size":{"scaleY":10,"scaleX":10,"offsetX":0,"offsetY":0}}}],"class":"Attachment","name":"OwnerBillboard","path":"Workspace.Map.Plots.PlotTemplate.OwnerBillboard"},{"children":[{"children":[{"name":"1","class":"Attachment"},{"name":"2","class":"Attachment"},{"name":"3","class":"Attachment"},{"name":"4","class":"Attachment"},{"name":"5","class":"Attachment"},{"name":"6","class":"Attachment"},{"name":"7","class":"Attachment"},{"name":"8","class":"Attachment"},{"name":"9","class":"Attachment"},{"name":"10","class":"Attachment"},{"name":"11","class":"Attachment"},{"name":"13","class":"Attachment"},{"name":"12","class":"Attachment"}],"class":"Folder","name":"Placement","path":"Workspace.Map.Plots.PlotTemplate.Platforms.Placement"},{"class":"Folder","name":"Platforms","path":"Workspace.Map.Plots.PlotTemplate.Platforms.Platforms"}],"class":"Folder","name":"Platforms","path":"Workspace.Map.Plots.PlotTemplate.Platforms"},{"children":[{"path":"Workspace.Map.Plots.PlotTemplate.NPC's.Sell","name":"Sell","scripts_inside":["Script:dialogueScript","Script:AP"],"primary_part":"Root","class":"Model","pivot":[-73.14381408691406,8.449959754943848,389.77093505859377],"children":[{"name":"Money","class":"Model"},{"name":"Body Colors","class":"BodyColors"},{"name":"AnimationController","class":"AnimationController"},{"name":"Animation","class":"Animation"},{"name":"Right Leg","class":"Part"},{"name":"Torso","class":"Part"},{"name":"Head","class":"Part"},{"name":"Chair","class":"MeshPart"},{"name":"Left Arm","class":"Part"},{"name":"Left Leg","class":"Part"},{"name":"Right Arm","class":"Part"},{"name":"Root","class":"Part"},{"name":"ProximityPrompt","class":"ProximityPrompt"},{"path":"Workspace.Map.Plots.PlotTemplate.NPC's.Sell.dialogueScript","name":"dialogueScript","class":"Script","source":"-- services\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\n--modules\nlocal DialogModule = require(ReplicatedStorage.Packages.DialogueModule)\nlocal UIController = require(ReplicatedStorage.UIController)\n\n--references\nlocal player = game.Players.LocalPlayer\nlocal playerGui = player:WaitForChild(\"PlayerGui\")\nlocal MenuGui = playerGui:WaitForChild(\"MenuGui\")\nlocal npc = script.Parent -- Reference to the NPC model\nlocal npcGui = npc:WaitForChild(\"Head\"):WaitForChild(\"gui\")\nlocal prompt = npc:WaitForChild(\"ProximityPrompt\")\n\nlocal dialogueObject = DialogModule.new(\"Sell\", npc, prompt)\ndialogueObject:addDialogue(\"Got anything to sell?\", {\"I want to sell my brainrots.\", \"I want to sell my plants.\", \"I want to sell this.\", \"How much is this worth?\", \"Goodbye.\"})\n\n--\n\nlocal dialogueResponse = {}\n\nlocal Networker = require(ReplicatedStorage.Packages.Networker)\nlocal DataAggregation = require(ReplicatedStorage.Packages.DataAggregation)\nlocal EnemyData = require(ReplicatedStorage.Shared.Modules.Data.Enemies)\nlocal SharedUtils = require(ReplicatedStorage.Shared.Modules.SharedUtils)\nlocal PlantData = require(ReplicatedStorage.Shared.Modules.Data.Plants)\nlocal EffectsHandler = require(ReplicatedStorage.Shared.Modules.EffectsHandler)\n\nlocal sellNetworker = Networker.client.new(\"Sell\", dialogueResponse)\nlocal dataReplica = DataAggregation.GetReplica()\n\n-- what happens when triggered\nprompt.Triggered:Connect(function(player)\n\tdialogueObject:triggerdialogue(player, 1)\nend)\n\n-- logic to go through dialogs\ndialogueObject.responded:Connect(function(responseNum, dialogueNum)\n\tif dialogueNum == 1 then\n\t\tif responseNum == 1 then\n\t\t\tlocal sellAmount = 0\n\t\t\tlocal backpack = player.Backpack:GetChildren()\n\t\t\ttable.insert(backpack, player.Character:FindFirstChildWhichIsA(\"Tool\"))\n\t\t\tfor _, tool in backpack do\n\t\t\t\tif tool:HasTag(\"npcTool\") then\n\t\t\t\t\tlocal name = tool:GetAttribute(\"npc\")\n\t\t\t\t\tlocal enemyData = EnemyData[name]\n\t\t\t\t\tif enemyData then\n\t\t\t\t\t\tsellAmount += SharedUtils.calculateSellPrice(name, tool:GetAttribute(\"multiplier\"), tool:GetAttribute(\"mutation\"), player)\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\t\t\n\t\t\tif sellAmount > 0 then\n\t\t\t\tsellNetworker:fire(\"sellAllNPCs\")\n\t\t\t\tdialogueObject:hideGui(`Sure! Here's <font color=\"rgb(90, 255, 78)\">${SharedUtils.ShortenValue(sellAmount)}</font>`)\n\t\t\t\tEffectsHandler.CashEffect()\n\t\t\telse\n\t\t\t\tdialogueObject:hideGui(\"You have no brainrots to sell.\")\n\t\t\tend\n\t\telseif responseNum == 2 then\n\t\t\tlocal sellAmount = 0\n\t\t\tlocal backpack = player.Backpack:GetChildren()\n\t\t\ttable.insert(backpack, player.Character:FindFirstChildWhichIsA(\"Tool\"))\n\t\t\tfor _, tool in backpack do\n\t\t\t\tif tool:HasTag(\"seed\") then\n\t\t\t\t\tlocal plantNum = tool:GetAttribute(\"plantNumber\")\n\t\t\t\t\tif not plantNum then\n\t\t\t\t\t\tcontinue\n\t\t\t\t\tend\n\t\t\t\t\tlocal name = tool:GetAttribute(\"plant\")\n\t\t\t\t\tlocal plantData = PlantData[name]\n\t\t\t\t\tif PlantData then\n\t\t\t\t\t\tsellAmount += SharedUtils.calculateSellPrice(name, tool:GetAttribute(\"multiplier\"), tool:GetAttribute(\"mutation\"), player)\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\n\t\t\tif sellAmount > 0 then\n\t\t\t\tsellNetworker:fire(\"sellAllPlants\")\n\t\t\t\tdialogueObject:hideGui(`Sure! Here's <font color=\"rgb(90, 255, 78)\">${SharedUtils.ShortenValue(sellAmount)}</font>`)\n\t\t\t\tEffectsHandler.CashEffect()\n\t\t\telse\n\t\t\t\tdialogueObject:hideGui(\"You have no plants to sell.\")\n\t\t\tend\n\t\telseif responseNum == 3 then\n\t\t\tlocal equippedTool = player.Character:FindFirstChildWhichIsA(\"Tool\")\n\t\t\tif equippedTool then\n\t\t\t\tlocal sellPrice = 0\n\t\t\t\tif equippedTool:HasTag(\"npcTool\") then\n\t\t\t\t\tsellPrice = SharedUtils.calculateSellPrice(equippedTool:GetAttribute(\"npc\"), equippedTool:GetAttribute(\"multiplier\"), equippedTool:GetAttribute(\"mutation\"), player)\n\t\t\t\telseif equippedTool:HasTag(\"seed\") and equippedTool:GetAttribute(\"plantNumber\") ~= nil then\n\t\t\t\t\tsellPrice = SharedUtils.calculateSellPrice(equippedTool:GetAttribute(\"plant\"), equippedTool:GetAttribute(\"multiplier\"), equippedTool:GetAttribute(\"mutation\"), player)\n\t\t\t\tend\n\t\t\t\t\n\t\t\t\tsellNetworker:fire(\"sellHoldingItem\", equippedTool)\n\t\t\t\tdialogueObject:hideGui(`Sure! Here's <font color=\"rgb(90, 255, 78)\">${SharedUtils.ShortenValue(sellPrice)}</font>.`)\n\t\t\t\tEffectsHandler.CashEffect()\n\t\t\telse\n\t\t\t\tdialogueObject:hideGui(\"You need to equip something first.\")\n\t\t\tend\n\t\telseif responseNum == 4 then\n\t\t\tlocal equippedTool = player.Character:FindFirstChildWhichIsA(\"Tool\")\n\t\t\tif equippedTool then\n\t\t\t\tlocal sellPrice = 0\n\t\t\t\tif equippedTool:HasTag(\"npcTool\") then\n\t\t\t\t\tsellPrice = SharedUtils.calculateSellPrice(equippedTool:GetAttribute(\"npc\"), equippedTool:GetAttribute(\"multiplier\"), equippedTool:GetAttribute(\"mutation\"), player)\n\t\t\t\telseif equippedTool:HasTag(\"seed\") and equippedTool:GetAttribute(\"plantNumber\") ~= nil then\n\t\t\t\t\tsellPrice = SharedUtils.calculateSellPrice(equippedTool:GetAttribute(\"plant\"), equippedTool:GetAttribute(\"multiplier\"), equippedTool:GetAttribute(\"mutation\"), player)\n\t\t\t\tend\n\n\t\t\t\tdialogueObject:hideGui(`It's worth <font color=\"rgb(90, 255, 78)\">${SharedUtils.ShortenValue(sellPrice)}</font>.`)\n\t\t\telse\n\t\t\t\tdialogueObject:hideGui(\"You need to equip something first.\")\n\t\t\tend\n\t\telseif responseNum == 5 then\n\t\t\tdialogueObject:hideGui(\"\")\n\t\tend\n\tend\nend)","source_